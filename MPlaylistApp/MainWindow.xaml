<Window Background="#121212" Height="720" Title="M-Playlist Native Engine" Width="1280" WindowStartupLocation="CenterScreen" x:Class="MPlaylistApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:MPlaylistApp" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- Video Preview Container (Left) -->
        <Border x:Name="VideoContainer" Background="Black" Margin="10" Grid.Column="0">
            <!-- VideoHwndHost will be injected here via code-behind -->
        </Border>

        <!-- Control Dashboard (Right) -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- A/V Sync Diagnostic & Audio Out -->
            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00FF00" HorizontalAlignment="Center" Margin="0,0,0,10" Text="A: 0.000s | V: 0.000s" x:Name="TimecodeText"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock FontSize="12" Foreground="#AAAAAA" Text="Hardware Delay: " VerticalAlignment="Center"/>
                    <Slider IsSnapToTickEnabled="True" Maximum="500" Minimum="-500" TickFrequency="10" Value="80" ValueChanged="OnSyncSliderChanged" Width="120" x:Name="SyncSlider"/>
                    <TextBlock FontSize="12" Foreground="#AAAAAA" Margin="5,0,0,0" Text="80 ms" VerticalAlignment="Center" Width="45" x:Name="SyncLabel"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="Audio Out:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="AudioDeviceCombo" Width="200" SelectionChanged="AudioDeviceCombo_SelectionChanged"/>
                </StackPanel>

                <CheckBox x:Name="NdiBroadcastCheckBox" Content="Enable NDI Broadcast" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10" Checked="NdiBroadcastCheckBox_Checked" Unchecked="NdiBroadcastCheckBox_Unchecked"/>
            </StackPanel>

            <!-- Playlist -->
            <ListBox Grid.Row="1" Background="#222222" BorderBrush="#444" Foreground="White" x:Name="PlaylistUI" AllowDrop="True" Drop="PlaylistUI_Drop" Margin="0,0,0,10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Vertical" Margin="0,5,0,5">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="In:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding InPointHnsecs, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,10,0"/>
                                <TextBlock Text="Out:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding OutPointHnsecs, UpdateSourceTrigger=PropertyChanged}" Width="50" Margin="0,0,10,0"/>
                                <TextBlock Text="Trans:" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox Text="{Binding TransitionDurationHnsecs, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Bottom Controls -->
            <StackPanel Grid.Row="2" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button Background="#333" Click="OnAddCueClicked" Content="Add Cues" Foreground="White" Height="40" Margin="0,0,10,0" Width="100"/>
                    <Button Background="#1E90FF" Click="OnFireNextClicked" Content="FIRE NEXT" FontWeight="Bold" Foreground="White" Height="40" Width="120"/>
                </StackPanel>
                
                <TextBlock x:Name="StatusText" Text="Waiting for Sync..." Foreground="#00FF00" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                
                <Slider x:Name="TimelineSlider" Maximum="300000000" primitives:Thumb.DragStarted="Timeline_DragStarted" primitives:Thumb.DragCompleted="Timeline_DragCompleted"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
