<Window x:Class="MPlaylistApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MPlaylistApp"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="M-Playlist Native Engine (Broadcast Mode)" Height="760" Width="1280" 
        WindowStartupLocation="CenterScreen" 
        Background="#121212" Foreground="White">
    
    <Window.Resources>
        <local:TimecodeConverter x:Key="TimecodeConverter"/>
        <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <ContextMenu x:Key="VideoTrimMenu" Background="#222" Foreground="White">
            <MenuItem Header="Set IN Point (Current Time)" Click="ContextMenuSetIn_Click"/>
            <MenuItem Header="Set OUT Point (Current Time)" Click="ContextMenuSetOut_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Hardware Settings -->
            <RowDefinition Height="*"/>    <!-- Main Workspace -->
        </Grid.RowDefinitions>

        <!-- Modality 6: Off-Screen Chromium HTML5 Renderer -->
        <Canvas Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <wv2:WebView2 x:Name="OverlayBrowser" 
                          Width="1920" Height="1080" 
                          Canvas.Left="-32000" Canvas.Top="-32000" />
        </Canvas>

        <!-- TOP: Hardware Settings Expander -->
        <Expander Grid.Row="0" Header="[ HARDWARE &amp; NDI CONFIGURATION ]" Foreground="#AAAAAA" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Margin="0,0,30,0">
                    <TextBlock Text="Audio Out:" Foreground="Gray" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AudioDeviceCombo" Width="200" SelectionChanged="AudioDeviceCombo_SelectionChanged"/>
                <Button Background="#FF8C00" Click="OnBundleShowClicked" Content="📦 Bundle Show" Foreground="White" Height="40" Margin="10,0,0,0"/>
                  </StackPanel>
                
                <StackPanel Margin="0,0,30,0">
                    <TextBlock FontSize="12" Foreground="#AAAAAA" Text="Hardware Delay: " Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Slider x:Name="SyncSlider" IsSnapToTickEnabled="True" Maximum="500" Minimum="-500" TickFrequency="10" Value="80" ValueChanged="OnSyncSliderChanged" Width="120" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SyncLabel" FontSize="12" Foreground="#AAAAAA" Margin="10,0,0,0" Text="80 ms" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,30,0">
                    <CheckBox x:Name="NdiBroadcastCheckBox" Content="Enable NDI Broadcast" Foreground="White" Checked="NdiBroadcastCheckBox_Checked" Unchecked="NdiBroadcastCheckBox_Unchecked" VerticalAlignment="Center" Margin="0,20,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Output Corner Pinning" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="TL X" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderTLX" Grid.Row="0" Grid.Column="1" Minimum="-2" Maximum="2" Value="-1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblTLX" Grid.Row="0" Grid.Column="2" Text="-1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="TL Y" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderTLY" Grid.Row="1" Grid.Column="1" Minimum="-2" Maximum="2" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblTLY" Grid.Row="1" Grid.Column="2" Text="1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="TR X" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderTRX" Grid.Row="0" Grid.Column="4" Minimum="-2" Maximum="2" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblTRX" Grid.Row="0" Grid.Column="5" Text="1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" Text="TR Y" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderTRY" Grid.Row="1" Grid.Column="4" Minimum="-2" Maximum="2" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblTRY" Grid.Row="1" Grid.Column="5" Text="1.00" Foreground="Gray" Margin="5,0,15,0"/>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="BL X" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderBLX" Grid.Row="2" Grid.Column="1" Minimum="-2" Maximum="2" Value="-1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblBLX" Grid.Row="2" Grid.Column="2" Text="-1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="BL Y" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderBLY" Grid.Row="3" Grid.Column="1" Minimum="-2" Maximum="2" Value="-1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblBLY" Grid.Row="3" Grid.Column="2" Text="-1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="BR X" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderBRX" Grid.Row="2" Grid.Column="4" Minimum="-2" Maximum="2" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblBRX" Grid.Row="2" Grid.Column="5" Text="1.00" Foreground="Gray" Margin="5,0,15,0"/>

                        <TextBlock Grid.Row="3" Grid.Column="3" Text="BR Y" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderBRY" Grid.Row="3" Grid.Column="4" Minimum="-2" Maximum="2" Value="-1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCornerSliderChanged"/>
                        <TextBlock x:Name="LblBRY" Grid.Row="3" Grid.Column="5" Text="-1.00" Foreground="Gray" Margin="5,0,15,0"/>
                    </Grid>
                </StackPanel>

                <StackPanel Margin="30,0,0,0">
                    <TextBlock Text="Transform &amp; Color" Foreground="Gray" FontWeight="Bold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="60"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <!-- Crop -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Crop L" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderCropL" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCropSliderChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Crop R" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderCropR" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnCropSliderChanged"/>
                        <!-- Pan Zoom -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Pan X" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderPanX" Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnPanZoomSliderChanged"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Zoom" Foreground="Gray" Margin="0,0,5,0"/>
                        <Slider x:Name="SliderZoom" Grid.Row="3" Grid.Column="1" Minimum="0.1" Maximum="5" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnPanZoomSliderChanged"/>
                        <!-- Color -->
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Bright" Foreground="Gray" Margin="10,0,5,0"/>
                        <Slider x:Name="SliderBright" Grid.Row="0" Grid.Column="4" Minimum="-1" Maximum="1" Value="0" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnColorSliderChanged"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="Contrst" Foreground="Gray" Margin="10,0,5,0"/>
                        <Slider x:Name="SliderContrast" Grid.Row="1" Grid.Column="4" Minimum="0" Maximum="3" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnColorSliderChanged"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Saturat" Foreground="Gray" Margin="10,0,5,0"/>
                        <Slider x:Name="SliderSat" Grid.Row="2" Grid.Column="4" Minimum="0" Maximum="3" Value="1" TickFrequency="0.01" IsSnapToTickEnabled="True" ValueChanged="OnColorSliderChanged"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Expander>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />    <!-- Playlist -->
                <ColumnDefinition Width="600" />  <!-- Viewport + Transport -->
                <ColumnDefinition Width="300" />  <!-- Inspector -->
            </Grid.ColumnDefinitions>

            <!-- LEFT: Playlist -->
            <Grid Grid.Column="0" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="PLAYLIST" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalDurationText" Text="TOTAL: 00:00:00.00" Foreground="White" FontWeight="Bold" Margin="10,0,0,0"/>
                </StackPanel>
                
                <ListView Grid.Row="1" Background="#222222" BorderBrush="#444" Foreground="White" x:Name="PlaylistUI" AllowDrop="True" Drop="PlaylistUI_Drop" Margin="0,0,0,10">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsActivePlaying}" Value="True">
                                    <Setter Property="Background" Value="#8B0000"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding ColorTag, Converter={StaticResource StringToBrushConverter}}" BorderThickness="4,0,0,0" Padding="5">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                    <!-- Crossfade Control -->
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Crossfade (ms): " Foreground="#888" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding TransitionMs, UpdateSourceTrigger=PropertyChanged}" Width="50" Background="#333" Foreground="White"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,5">
                                        <TextBlock Text="Dur: " Foreground="#888" FontSize="11"/>
                                        <TextBlock Text="{Binding DurationHNS, Converter={StaticResource TimecodeConverter}}" Foreground="#AAA" FontSize="11" Margin="0,0,10,0"/>
                                        <TextBlock Text="In: " Foreground="#888" FontSize="11"/>
                                        <TextBlock Text="{Binding InPointHNS, Converter={StaticResource TimecodeConverter}}" Foreground="#AAA" FontSize="11" Margin="0,0,10,0"/>
                                        <TextBlock Text="Out: " Foreground="#888" FontSize="11"/>
                                        <TextBlock Text="{Binding OutPointHNS, Converter={StaticResource TimecodeConverter}}" Foreground="#AAA" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <Button Background="#333" Click="OnAddCueClicked" Content="+ Add Cues" Foreground="White" Height="40" Width="100" Margin="0,0,10,0"/>
                    <Button Background="#333" Click="AddLocalCamera_Click" Content="+ Add Camera" Foreground="White" Height="40" Width="100"/>
                    <Button Background="#333" Click="AddDxgi_Click" Content="+ DXGI" Foreground="White" Height="40" Width="80" Margin="10,0,0,0"/>
                    <Button Background="#333" Click="AddSdi_Click" Content="+ SDI" Foreground="White" Height="40" Width="80" Margin="10,0,0,0"/>
                    <Button Background="#333" Click="AddHtmlOverlay_Click" Content="+ HTML5 Overlay" Foreground="White" Height="40" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- CENTER: Viewport & Transport -->
            <Grid Grid.Column="1" Margin="10,10,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#00FF00" HorizontalAlignment="Center" Margin="0,0,0,10" Text="A: 00:00:00:00 | V: 00:00:00:00" x:Name="TimecodeText"/>

                <Border Grid.Row="1" x:Name="VideoContainer" Background="Black" BorderBrush="#333" BorderThickness="1">
                    <!-- VideoHwndHost injected here -->
                </Border>

                <Slider Grid.Row="2" x:Name="TimelineSlider" Margin="0,10,0,10" 
                        IsMoveToPointEnabled="True"
                        PreviewMouseLeftButtonDown="TimelineSlider_PreviewMouseLeftButtonDown" 
                        PreviewMouseLeftButtonUp="TimelineSlider_PreviewMouseLeftButtonUp"
                        primitives:Thumb.DragStarted="Timeline_DragStarted" 
                        primitives:Thumb.DragCompleted="Timeline_DragCompleted"/>

                <StackPanel Grid.Row="3" Margin="0,15,0,5">
                    <!-- ðŸŽ›ï¸ THE BROADCAST AUDIO DASHBOARD -->
                    <Border Background="#111" BorderBrush="#333" BorderThickness="1" Padding="15,10" Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Master Fader -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="MASTER" Foreground="#AAA" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Slider x:Name="MasterVolumeSlider" Minimum="-60" Maximum="6" Value="0" Width="100" VerticalAlignment="Center" ValueChanged="OnVolumeSliderChanged" Style="{x:Null}"/>
                                <TextBlock Text="{Binding Value, ElementName=MasterVolumeSlider, StringFormat={}{0:F1} dB}" Foreground="#00FFCC" FontFamily="Consolas" VerticalAlignment="Center" Margin="10,0,0,0" Width="50" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- Horizontal VU Meters -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="L" Foreground="#888" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Width="12"/>
                                    <Border Grid.Column="1" Background="#050505" BorderBrush="#222" BorderThickness="1" Height="14" CornerRadius="2">
                                        <Rectangle HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FF00" Offset="0.0" />
                                                    <GradientStop Color="#00FF00" Offset="0.75" />
                                                    <GradientStop Color="#FFFF00" Offset="0.85" />
                                                    <GradientStop Color="#FF0000" Offset="0.95" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="MeterLeftScale" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="R" Foreground="#888" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0" Width="12"/>
                                    <Border Grid.Column="1" Background="#050505" BorderBrush="#222" BorderThickness="1" Height="14" CornerRadius="2">
                                        <Rectangle HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#00FF00" Offset="0.0" />
                                                    <GradientStop Color="#00FF00" Offset="0.75" />
                                                    <GradientStop Color="#FFFF00" Offset="0.85" />
                                                    <GradientStop Color="#FF0000" Offset="0.95" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform x:Name="MeterRightScale" ScaleX="0" />
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- Raw Numeric Probes -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock x:Name="VuTextL" Text="L: -INF" Foreground="#00FF00" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock x:Name="VuTextR" Text="R: -INF" Foreground="#00FF00" FontFamily="Consolas" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TRANSPORT CONTROLS -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="1" Click="OnTestCleanFeedClicked" Content="TEST CLEAN FEED" Background="#444" Foreground="White" FontWeight="Bold" Height="45" Width="130" Margin="0,0,10,0"/>
                        <Button Grid.Column="2" Click="OnStopClicked" Content="â–  STOP" Background="#8B0000" Foreground="White" FontWeight="Bold" Height="45" Width="100" Margin="0,0,10,0"/>
                        <Button Grid.Column="3" Click="OnPauseClicked" Content="â¸ PAUSE" Background="#333" Foreground="White" FontWeight="Bold" Height="45" Width="100" Margin="0,0,10,0"/>
                        <Button Grid.Column="4" Click="PlayFireNext_Click" Content="â–¶ PLAY / FIRE NEXT" Background="#1E90FF" Foreground="White" FontWeight="Bold" Height="45" Width="180"/>
                    </Grid>
                </StackPanel>
                
                <TextBlock x:Name="StatusText" FontFamily="Consolas" Foreground="#888" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                  <CheckBox x:Name="ChaseLtcToggle" Content="Chase External Timecode (LTC)" Foreground="#888" HorizontalAlignment="Center" Margin="0,10,0,0" />
            </Grid>

            <!-- RIGHT: Cue Inspector -->
            <Border Grid.Column="2" Background="#1E1E1E" BorderBrush="#333" BorderThickness="1" Margin="10">
                <StackPanel DataContext="{Binding SelectedItem, ElementName=PlaylistUI}" Margin="15">
                    <TextBlock Text="CUE INSPECTOR" FontWeight="Bold" Foreground="#888" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    
                    <TextBlock Text="Cue ID" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding CueID, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="Title" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,10"/>
                    
                    <TextBlock Text="End Behavior" Foreground="#888" Margin="0,0,0,2"/>
                    <ComboBox SelectedItem="{Binding EndBehavior, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="Black" Margin="0,0,0,10" x:Name="ComboEndBehavior"/>
                    
                    <TextBlock Text="Color Tag" Foreground="#888" Margin="0,0,0,2"/>
                    <ComboBox SelectedValue="{Binding ColorTag, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Background="#333" Foreground="Black" Margin="0,0,0,10">
                        <ComboBoxItem Content="#444444" />
                        <ComboBoxItem Content="#FF0000" />
                        <ComboBoxItem Content="#00FF00" />
                        <ComboBoxItem Content="#0000FF" />
                    </ComboBox>

                    <TextBlock Text="Hardware Video Overlay" Foreground="#888" Margin="0,15,0,2"/>
                    <CheckBox x:Name="OverlayToggle" Content="SHOW TIMECODE OVERLAY" Foreground="White" FontWeight="Bold" Margin="0,0,0,10" Checked="OverlayToggle_Changed" Unchecked="OverlayToggle_Changed"/>
                    
                    <TextBlock Text="Trim Points" Foreground="#888" Margin="0,0,0,2"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Button Grid.Row="0" Grid.Column="0" Content=" SET IN " Click="OnSetInPointClicked" Background="#333" Foreground="White" Padding="5,2" Margin="0,0,5,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InPointHNS, Converter={StaticResource TimecodeConverter}}" Background="#333" Foreground="White" Padding="5" Margin="0,0,0,5" VerticalAlignment="Center"/>
                        
                        <Button Grid.Row="1" Grid.Column="0" Content=" SET OUT " Click="OnSetOutPointClicked" Background="#333" Foreground="White" Padding="5,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OutPointHNS, Converter={StaticResource TimecodeConverter}}" Background="#333" Foreground="White" Padding="5" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <TextBlock Text="Volume (dB)" Foreground="#888" Margin="0,0,0,2"/>
                    <Slider Value="{Binding VolumeDb, UpdateSourceTrigger=PropertyChanged}" Minimum="-60" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,10" ValueChanged="OnVolumeSliderChanged"/>
                    <Button Content="Normalize Audio (-14 LUFS)" Background="#555" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,10" Click="NormalizeAudio_Click"/>
                      <Button Content="Hardware Conformity (H.264 / AAC)" Background="#555" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,10" Click="TranscodeVideo_Click"/>
                    
                    <TextBlock Text="Notes" Foreground="#888" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Background="#333" Foreground="White" BorderThickness="0" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" Height="80"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

